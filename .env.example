
# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# HMAC session-signing secret. Generate one with: openssl rand -hex 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Database — managed/cloud MySQL (e.g. PlanetScale, AWS RDS, DigitalOcean)
# ---------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=e-learning
# Most managed providers require TLS. Set to "false" to disable (local/dev only).
MYSQL_SSL=true
MYSQL_POOL_SIZE=10

# Local development only — an alternative to MYSQL_HOST for a Unix-socket
# connection to a local MySQL install. Leave MYSQL_HOST empty to use this.
# MYSQL_SOCKET=/path/to/mysql.sock

# ---------------------------------------------------------------------------
# This app's own public URL — used to build the bKash callback URL
# (must be reachable from bKash's servers, so not localhost in production).
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Payments — bKash
# ---------------------------------------------------------------------------
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=
BKASH_WEBHOOK_SECRET=
# BKASH_BASE_URL examples: https://tokenized.sandbox.bka.sh/v1.2.0-beta (sandbox)
# or the live base URL bKash issues at merchant onboarding.
#
# DEVELOPMENT ONLY: route the bKash adapter to the built-in simulator
# (/api/dev/bkash + /dev/bkash/pay). Ignored when NODE_ENV=production.
# BKASH_SIMULATOR=true

# ---------------------------------------------------------------------------
# File / video storage
# ---------------------------------------------------------------------------
# s3 | r2 | local
#   s3/r2 — private bucket; playback/download URLs are presigned per request
#           after a server-side access check (recommended for production).
#   local — files on this server under STORAGE_LOCAL_DIR (never in /public),
#           served through HMAC-signed, expiring /api/storage/* URLs. Good for
#           development and single-server hosting; not for multi-instance.
STORAGE_PROVIDER=s3
# STORAGE_LOCAL_DIR=./storage/private
# Signs local-provider media URLs (falls back to AUTH_SECRET). Required in
# production when STORAGE_PROVIDER=local.
# STORAGE_SIGNING_SECRET=
# STORAGE_ENDPOINT is required for R2; leave blank for AWS S3.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public/CDN base URL for the bucket's `thumbnails/` prefix specifically
# (course cover images — public, unlike lesson video which always goes
# through a signed URL). Grant only this prefix public-read; keep
# `videos/` private. e.g. https://cdn.example.com or the bucket's own
# public endpoint URL.
STORAGE_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Email (password-reset delivery) — NOT WIRED YET
# ---------------------------------------------------------------------------
# No email provider is integrated; reset links are never returned to the
# browser in production. DEVELOPMENT ONLY: return the reset link from
# /api/auth/forgot for local testing.
# AUTH_DEV_RESET_LINKS=true

# ---------------------------------------------------------------------------
# Local tooling
# ---------------------------------------------------------------------------
# Build folder (lets `npm run dev:local` run beside another dev server).
# NEXT_DIST_DIR=.next-local

# ---------------------------------------------------------------------------
NODE_ENV=development
