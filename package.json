{
  "name": "leo-learning",
  "version": "1.0.0",
  "private": true,
  "description": "Leo Learning — multi-tenant SaaS platform for Bangladeshi coaching centers",
  "scripts": {
    "dev": "next dev -p 3005",
    "dev:local": "PORT=${PORT:-3100}; MYSQL_HOST= STORAGE_PROVIDER=local BKASH_SIMULATOR=true AUTH_DEV_RESET_LINKS=true APP_BASE_URL=http://localhost:$PORT NEXT_DIST_DIR=.next-local next dev -p $PORT",
    "build": "next build",
    "start": "next start -p 3005",
    "test": "vitest run",
    "migrate": "node database/migrate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "file-type": "22.2.0",
    "mysql2": "^3.22.5",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "^9.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "4.1.12"
  },
  "overrides": {
    "vite": "8.3.4"
  }
}
